<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Votación</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <h1 class="text-center mb-4">🗳️ Elige tu opción</h1>
        <div class="row justify-content-center">
            <% opciones.forEach(opcion => { %>
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-body text-center">
                            <h5 class="card-title"><%= opcion.titulo %></h5>
                            <p class="text-muted small"><%= opcion.categoria %></p>
                            <!-- El formulario envía el ID a la ruta /votar/:id que definimos -->
                            <form action="/votar/<%= opcion._id %>" method="POST">
                                <button type="submit" class="btn btn-primary w-100">Votar</button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
        <div class="text-center mt-4">
            <a href="/resultados" class="btn btn-outline-secondary">Ver Resultados Reales</a>
        </div>
    </div>
</body>
</html>