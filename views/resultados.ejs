<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resultados de Votación</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-white">
    <div class="container mt-5">
        <h1 class="text-center mb-5">📊 Resultados Actuales</h1>
        <div class="row justify-content-center">
            <div class="col-md-8">
                <% opciones.forEach(opcion => { %>
                    <div class="mb-4">
                        <div class="d-flex justify-content-between">
                            <span><%= opcion.titulo %></span>
                            <span class="badge bg-success"><%= opcion.votos %> votos</span>
                        </div>
                        <div class="progress mt-2" style="height: 25px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-info" 
                                 role="progressbar" 
                                 style="width: <%= (opcion.votos > 0) ? (opcion.votos * 10) : 5 %>%">
                            </div>
                        </div>
                    </div>
                <% }) %>
                <hr>
                <div class="text-center">
                    <a href="/" class="btn btn-warning">Volver a Votar</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>